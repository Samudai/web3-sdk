{
  "name": "@samudai_xyz/web3-sdk",
  "version": "0.1.0",
  "description": "",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "umd:main": "dist/umd/index.js",
  "types": "dist/types/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable",
    "prepare": "husky",
    "build": "npm run build:cjs && npm run build:esm && npm run build:umd && npm run build:types",
    "build:cjs": "node tools/cleanup cjs && tsc -p config/tsconfig.cjs.json",
    "build:esm": "node tools/cleanup esm && tsc -p config/tsconfig.esm.json",
    "build:umd": "node tools/cleanup umd && webpack --config config/webpack.config.js",
    "build:types": "node tools/cleanup types && tsc -p config/tsconfig.types.json",
    "clean": "node tools/cleanup",
    "typecheck": "tsc -p config/tsconfig.cjs.json --noEmit",
    "lint": "eslint src",
    "package": "npm run build && npm pack",
    "test": "jest --no-cache --runInBand --passWithNoTests",
    "test:cov": "jest --coverage --no-cache --runInBand --passWithNoTests",
    "addscope": "node tools/packagejson name @tomchen/example-typescript-package"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "samudai",
    "web3",
    "sdk",
    "web3-sdk"
  ],
  "author": "Samudai <https://samudai.xyz>",
  "license": "MIT",
  "homepage": "https://github.com/Samudai/web3-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/Samudai/web3-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Samudai/web3-sdk/issues"
  },
  "dependencies": {
    "@biconomy/account": "^4.5.7",
    "@ensdomains/eth-ens-namehash": "^2.0.15",
    "@lit-protocol/auth-helpers": "7.4.0",
    "@lit-protocol/constants": "7.4.0",
    "@lit-protocol/encryption": "7.4.0",
    "@lit-protocol/lit-node-client": "7.4.0",
    "@lit-protocol/types": "7.4.0",
    "@safe-global/api-kit": "^4.1.0",
    "@safe-global/protocol-kit": "^7.1.0",
    "@safe-global/types-kit": "^3.1.0",
    "@snapshot-labs/snapshot.js": "^0.14.0",
    "alchemy-sdk": "^3.6.0",
    "axios": "^1.7.0",
    "content-hash": "^2.5.2",
    "crypto-browserify": "^3.12.1",
    "ethers": "^6.13.0",
    "siwe": "^3.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@types/jest": "^29.5.13",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "pinst": "^3.0.0",
    "prettier": "^3.3.3",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
}
